# Copy this file to .env and fill in real values from the Discord Developer
# Portal (https://discord.com/developers/applications) -> Your App.
#
# NEVER commit your real .env file. If your repo is public, don't type real
# secrets into .env until you're inside the Codespace (see README).
# .env should be in the .gitignore

# General Information page -> APPLICATION ID
DISCORD_APPLICATION_ID=

# General Information page -> PUBLIC KEY
DISCORD_PUBLIC_KEY=

# Bot page -> Token (click "Reset Token" if you haven't generated one yet)
DISCORD_TOKEN=

# Discord user ID allowed to invoke /coldcall
COLD_CALL_USER_ID=

# Optional -- defaults to 3000 if not set
PORT=3000
